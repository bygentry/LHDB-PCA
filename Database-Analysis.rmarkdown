# Preliminaries

## Data Import & Exploration

```{r}
#| label: packages

options(repos = "http://cran.us.r-project.org")

pacman::p_load(psych, tidyverse, curl, mice, rlang, yaml, gridExtra, lme4, XML, lubridate, gratia, VIM)
```

```{r}
#| label: data import

# AMNIOTES 
amniote <- read.csv("https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/AmnioteDB2015/Amniote_Database_Aug_2015.csv")

# ANAGE
AnAge <- read_tsv(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/AnAge/anage_data.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# ERNEST
ernest <- read_delim(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/Ernest/Mammal_lifehistories_v2.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# PANTHERIA
pan <- read_tsv(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/PanTHERIA/PanTHERIA_1-0_WR05_Aug2008.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# Kappeler & Pereira 
kp <- read.csv(file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/Kappeler-Pereira/KP.csv")
```

```{r}
#| label: primate data extraction

# AMNIOTES

## filters out non primates
amniote_p <- amniote %>% filter(order == "Primates")

# ANAGE

## creates subset df for primates
AnAge_p <- AnAge %>% filter(Order == "Primates")

# ERNEST

## creates subset df for fprimates
ernest_p <- ernest %>% filter(order == "Primates")

# PANTHERIA

## creates subset df for primates
pan_p <- pan %>% filter(MSW05_Order == "Primates")

# Kappeler & Pereira is already only primates
```

```{r}
#| label: primate data cleaning

# AMNIOTES

## removes reptile and avian variables
amniote_p <- amniote_p %>% 
  select(-egg_mass_g, -incubation_d, -fledging_age_d, -egg_width_mm, -egg_length_mm, -fledging_mass_g)

## extracting vars for cross-database comparison
amniote_selected <- amniote_p %>% 
  transmute(
    genus = genus,
    species = species,
    body_mass = adult_body_mass_g,
    AFR = female_maturity_d,
    gest_len = gestation_d,
    IBI = inter_litter_or_interbirth_interval_y,
    max_longevity = maximum_longevity_y,
    age_at_maturity = NA,
    weaning_age = weaning_d,
  )

# ANAGE

## converts taxonomic vars to factors to aid in grouping
AnAge_p <- AnAge_p %>% 
  mutate(
    across(c(Kingdom, Class, Order, Genus, Species), as.factor)
  )

## extracting vars for cross-database comparison
AnAge_selected <- AnAge_p %>% 
  transmute(
    genus = Genus,
    species = Species,
    body_mass = `Body mass (g)`,
    AFR = NA,
    gest_len = `Gestation/Incubation (days)`,
    IBI = `Inter-litter/Interbirth interval`,
    max_longevity = `Maximum longevity (yrs)`,
    age_at_maturity = `Female maturity (days)`,
    weaning_age = `Weaning (days)`
  )

# ERNEST

## converts taxonomic vars to factors to aid in grouping
ernest_p <- ernest_p %>% 
  mutate(
    across(c(order, family, Genus, species), as.factor)
  )

ernest_selected <- ernest_p %>% 
  transmute(
    genus = genus,
    species = species,
    body_mass = `mass(g)`,
    AFR = `AFR(mo)`,
    # convert AFR to days
    gest_len = `gestation(mo)`,
    # convert gest_len to days
    IBI = `litters/year`,
    # convert to days by (365.25 * (1/'litters/year'))
    
  )
# PANTHERIA

## converts taxonmic vars to factors for easier grouping
pan_p <- pan_p %>% 
  mutate(
    across(c(MSW05_Order, MSW05_Family, MSW05_Genus, MSW05_Species), as.factor)
  )

## extracting vars for cross-database comparison
pan_p <- pan_p %>% 
  rename(
    genus = MSW05_Genus,
    species = MSW05_Species,
    body_mass = `5-1_AdultBodyMass_g`,
    AFR = `3-1_AgeatFirstBirth_d`,
    gest_len = `9-1_GestationLen_d`,
    IBI = `14-1_InterbirthInterval_d`,
    max_longevity = `17-1_MaxLongevity_m`,
    age_at_maturity = `23-1_SexualMaturityAge_d`,
    weaning_age = `25-1_WeaningAge_d`
  )

# KAPPELER & PEREIRA

# sets the value "803?" to "803" 
kp <- kp %>% 
  mutate(
    BM.F = readr::parse_number(as.character(BM.F))
  )

# converts data types to appropriate class
kp <- kp %>% 
  mutate(
    Family = as.factor(Family),
    Genus = as.factor(Genus),
    Species = as.factor(Species),
    BM.F = as.numeric(BM.F)
  )
```

