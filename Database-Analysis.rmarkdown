```{r}
#| label: misc
vars <- colnames(pan_p)
count = 0
i = 0

# finding max value of numeric variables
# for pantheria if max = -999, no data is available for any species
for(i in 1:ncol(pan_p)){
  if(is.numeric(pan_p[[i]])){
    cat(names(pan_p)[i], ": ", max(pan_p[[i]]), "\n")
  }
}

```

