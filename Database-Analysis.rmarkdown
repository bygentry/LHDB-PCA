# Preliminaries

## Data Import & Exploration

```{r}
#| label: packages

options(repos = "http://cran.us.r-project.org")

pacman::p_load(psych, tidyverse, curl, mice, rlang, yaml, gridExtra, lme4, XML, lubridate, gratia, VIM)
```

```{r}
#| label: data import

# AMNIOTES 
amniote <- read.csv("https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/AmnioteDB2015/Amniote_Database_Aug_2015.csv")

# ANAGE
AnAge <- read_tsv(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/AnAge/anage_data.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# ERNEST
ernest <- read_delim(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/Ernest/Mammal_lifehistories_v2.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# PANTHERIA
pan <- read_tsv(
  file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/PanTHERIA/PanTHERIA_1-0_WR05_Aug2008.txt", 
  col_names = TRUE, 
  show_col_types = FALSE
  )

# Kappeler & Pereira 
kp <- read.csv(file = "https://raw.githubusercontent.com/bygentry/LHDB-PCA/main/Data/Kappeler-Pereira/KP.csv")
```

```{r}
#| label: primate data extraction

# AMNIOTES

## filters out non primates
amniote_p <- amniote %>% filter(order == "Primates")

# ANAGE

## creates subset df for primates
AnAge_p <- AnAge %>% filter(Order == "Primates")

# ERNEST

## creates subset df for fprimates
ernest_p <- ernest %>% filter(order == "Primates")

# PANTHERIA

## creates subset df for primates
pan_p <- pan %>% filter(MSW05_Order == "Primates")

# Kappeler & Pereira is already only primates
```

```{r}
#| label: primate data cleaning

# AMNIOTES

## removes reptile and avian variables
amniote_p <- amniote_p %>% 
  select(-egg_mass_g, -incubation_d, -fledging_age_d, -egg_width_mm, -egg_length_mm, -fledging_mass_g)

# ANAGE

## converts taxonomic vars to factors to aid in grouping
AnAge_p <- AnAge_p %>% 
  mutate(
    across(c(Kingdom, Class, Order, Genus, Species), as.factor)
  )

# ERNEST

## converts taxonomic vars to factors to aid in grouping
ernest_p <- ernest_p %>% 
  mutate(
    across(c(order, family, Genus, species), as.factor)
  )

# PANTHERIA

## converts taxonmic vars to factors for easier grouping
pan_p <- pan_p %>% 
  mutate(
    across(c(MSW05_Order, MSW05_Family, MSW05_Genus, MSW05_Species), as.factor)
  )

## renaming vars for easier indexing
pan_p <- pan_p %>% 
  rename(
    order = MSW05_Order,
    family = MSW05_Family,
    genus = MSW05_Genus,
    species = MSW05_Species,
    # stepping away: was removing vars that ARENT in the comparison table to make "select" tables
    adultBodyMass_g = `5-1_AdultBodyMass_g`,
    adultForearmLen_mm = `8-1_AdultForearmLen_mm`,
    adultHeadBodyLen_mm = `13-1_AdultHeadBodyLen_mm`,
    ageAtEyeOpening_d = `2-1_AgeatEyeOpening_d`,
    ageAtFirstBirth_d = `3-1_AgeatFirstBirth_d`,
    basalMetRate_mLO2hr = `18-1_BasalMetRate_mLO2hr`,
    basalMetRateMass_g = `5-2_BasalMetRateMass_g`,
    dietBreadth = `6-1_DietBreadth`,
    dispersalAge_d = `7-1_DispersalAge_d`,
    gestationLen_d = `9-1_GestationLen_d`,
    habitatBreadth = `12-1_HabitatBreadth`,
    homeRange_km2 = `22-1_HomeRange_km2`,
    homeRangeIndiv_km2 = `22-2_HomeRange_Indiv_km2`,
    interBirthInterval_d = `14-1_InterbirthInterval_d`,
    litterSize = `15-1_LitterSize`,
    littersPerYear = `16-1_LittersPerYear`,
    maxLongevity_m = `17-1_MaxLongevity_m`,
    neonateBodyMass_g = `5-3_NeonateBodyMass_g`,
    neoNateHeadBodyLen_mm = `13-2_NeonateHeadBodyLen_mm`,
    populationDensity = `21-1_PopulationDensity_n/km2`,
    populationGrpSize = `10-1_PopulationGrpSize`,
    sexualMaturityAge_d = `23-1_SexualMaturityAge_d`,
    socialGrpSize = `10-2_SocialGrpSize`,
    teatNumber = `24-1_TeatNumber`,
    terrestriality = `12-2_Terrestriality`,
    trophicLevel = `6-2_TrophicLevel`,
    weaningAge_d = `25-1_WeaningAge_d`,
    weaningBodyMass_g = `5-4_WeaningBodyMass_g`,
    weaningHeadBodyLen_mm = `13-3_WeaningHeadBodyLen_mm`
  )

# KAPPELER & PEREIRA

# sets the value "803?" to "803" 
kp <- kp %>% 
  mutate(
    BM.F = readr::parse_number(as.character(BM.F))
  )

# converts data types to appropriate class
kp <- kp %>% 
  mutate(
    Family = as.factor(Family),
    Genus = as.factor(Genus),
    Species = as.factor(Species),
    BM.F = as.numeric(BM.F)
  )
```

